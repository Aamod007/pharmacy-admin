# ==============================================================================
# PHARMACY ADMIN MONOREPO ENVIRONMENT VARIABLES
# ==============================================================================

# Core Database: Postgres database of the MAIN store
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medico?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/medico?schema=public&sslmode=prefer"

# Redis Cache, BullMQ Queues & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Main Storefront Integration
MAIN_SITE_URL="http://localhost:3000"
REVALIDATE_SECRET="pharmacy_revalidate_secret_super_secure_token_2026"
INTERNAL_API_KEY="pharmacy_internal_api_key_for_webhook_replay_2026"

# Admin Authentication & Security
JWT_ACCESS_SECRET="pharmacy_admin_jwt_access_secret_min_32_characters_long_key"
JWT_REFRESH_SECRET="pharmacy_admin_jwt_refresh_secret_min_32_characters_long_key"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
COOKIE_DOMAIN="localhost"
ADMIN_ALLOWED_IPS="" # Optional comma-separated IP allowlist (e.g. "127.0.0.1,192.168.1.100")

# Razorpay Integration (Reconciliation and Refunds Only)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"

# Transactional Emails (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@pharmacy.com"
SMTP_PASS="app_specific_password_here"
EMAIL_FROM="Pharmacy Care <notifications@pharmacy.com>"

# Cloudinary / S3 Media Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Admin API Server Settings
PORT=5001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3001"

# Admin Web Application Settings
NEXT_PUBLIC_API_URL="http://localhost:5001/api/v1"
NEXT_PUBLIC_APP_NAME="Pharmico Admin"
NEXT_PUBLIC_THEME_VARIANT="pharmacy-green" # Options: "pharmacy-green" | "reference-blue"
