{
  "name": "pharmacy-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Admin Control Center for Medical E-Commerce Pharmacy",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@pharmacy-admin/admin-api",
    "dev:web": "npm run dev --workspace=@pharmacy-admin/admin-web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@pharmacy-admin/db",
    "db:migrate": "npm run db:migrate --workspace=@pharmacy-admin/db",
    "db:seed": "npm run db:seed --workspace=@pharmacy-admin/db",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.3.3",
    "supertest": "^7.3.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
