datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// MAIN SITE ENUMS
// ============================================================================

enum Role {
  CUSTOMER
  PHARMACIST
  ADMIN
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  CREATED
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabBookingStatus {
  SCHEDULED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum NotificationType {
  ORDER
  PRESCRIPTION
  PAYMENT
  PROMO
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ============================================================================
// ADMIN-OWNED ENUMS
// ============================================================================

enum AdminStockMovementType {
  PURCHASE
  SALE
  RETURN_RESTOCK
  DAMAGE
  EXPIRED
  CORRECTION
  AUDIT_ADJUSTMENT
}

enum AdminPurchaseStatus {
  DRAFT
  RECEIVED
  VERIFIED
  CANCELLED
}

enum AdminTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AdminTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AdminSenderType {
  ADMIN
  CUSTOMER
  SYSTEM
}

enum AdminNotificationChannel {
  EMAIL
  SMS
  SSE
  REDIS_SYNC
  REVALIDATION_WEBHOOK
}

enum AdminNotificationStatus {
  SUCCESS
  FAILED
  RETRYING
}

enum AdminWebhookSource {
  RAZORPAY
  SHIPROCKET
  MAIN_SITE
}

enum AdminWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum AdminImportType {
  PRODUCTS
  INVENTORY_BATCHES
  PINCODES
  PRICES
}

enum AdminImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AdminCreditNoteStatus {
  ISSUED
  APPLIED
  CANCELLED
}

// ============================================================================
// MAIN SITE MODELS (READ & WRITTEN BY ADMIN-API)
// ============================================================================

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  phone           String        @unique
  passwordHash    String?
  role            Role          @default(CUSTOMER)
  isActive        Boolean       @default(true)
  isPhoneVerified Boolean       @default(false)
  isEmailVerified Boolean       @default(false)
  avatar          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  addresses       Address[]
  orders          Order[]
  prescriptions   Prescription[]       @relation("CustomerPrescriptions")
  approvedRx      Prescription[]       @relation("PharmacistApprovals")
  reviews         Review[]
  cart            Cart?
  wishlist        Wishlist[]
  labBookings     LabBooking[]
  appointments    Appointment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  statusUpdates   OrderStatusHistory[]
  supportTickets  AdminSupportTicket[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Address {
  id           String      @id @default(uuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  type         AddressType @default(HOME)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  labBookings  LabBooking[]

  @@index([userId])
  @@index([pincode])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  icon        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@index([isActive])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id                   String           @id @default(uuid())
  name                 String
  slug                 String           @unique
  description          String
  composition          String?
  uses                 String?
  sideEffects          String?
  dosage               String?
  storageInstructions  String?
  manufacturer         String
  countryOfOrigin      String           @default("India")
  hsnCode              String           @default("300490")
  gstRate              Decimal          @default(12.0) @db.Decimal(5, 2)
  prescriptionRequired Boolean          @default(false)
  scheduleType         String?
  brandId              String
  categoryId           String
  images               String[]         @default([])
  isFeatured           Boolean          @default(false)
  isBestSeller         Boolean          @default(false)
  isActive             Boolean          @default(true)
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  brand                Brand            @relation(fields: [brandId], references: [id])
  category             Category         @relation(fields: [categoryId], references: [id])
  variants             ProductVariant[]
  reviews              Review[]
  wishlist             Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([prescriptionRequired])
  @@index([isActive])
}

model ProductVariant {
  id              String               @id @default(uuid())
  productId       String
  sku             String               @unique
  name            String
  packSize        String
  price           Decimal              @db.Decimal(10, 2)
  mrp             Decimal              @db.Decimal(10, 2)
  discountPercent Int                  @default(0)
  isDefault       Boolean              @default(false)
  weightGrams     Int                  @default(100)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches         InventoryBatch[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  stockMovements  AdminStockMovement[]
  purchaseItems   AdminPurchaseItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model InventoryBatch {
  id             String               @id @default(uuid())
  variantId      String
  batchNumber    String
  mfgDate        DateTime
  expiryDate     DateTime
  quantity       Int                  @default(0)
  costPrice      Decimal              @db.Decimal(10, 2)
  isBlocked      Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  variant        ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockMovements AdminStockMovement[]

  @@index([variantId])
  @@index([expiryDate])
  @@index([batchNumber])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  usageLimit    Int          @default(1000)
  usedCount     Int          @default(0)
  startDate     DateTime     @default(now())
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]

  @@index([code])
  @@index([isActive])
}

model Order {
  id             String               @id @default(uuid())
  orderNumber    String               @unique
  userId         String
  addressId      String
  status         OrderStatus          @default(PLACED)
  subtotal       Decimal              @db.Decimal(10, 2)
  discount       Decimal              @default(0) @db.Decimal(10, 2)
  gstAmount      Decimal              @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal              @db.Decimal(10, 2)
  paymentMethod  PaymentMethod        @default(RAZORPAY)
  paymentStatus  PaymentStatus        @default(PENDING)
  prescriptionId String?
  couponId       String?
  deliverySlot   String?
  notes          String?
  cancelReason   String?
  invoiceUrl     String?
  isPaid         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  address        Address              @relation(fields: [addressId], references: [id])
  prescription   Prescription?        @relation(fields: [prescriptionId], references: [id])
  coupon         Coupon?              @relation(fields: [couponId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  refunds        Refund[]
  creditNotes    AdminCreditNote[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  variantId   String
  productName String
  packSize    String
  sku         String
  price       Decimal        @db.Decimal(10, 2)
  mrp         Decimal        @db.Decimal(10, 2)
  gstRate     Decimal        @db.Decimal(5, 2)
  gstAmount   Decimal        @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal        @db.Decimal(10, 2)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  status          OrderStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime    @default(now())

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?       @relation(fields: [changedByUserId], references: [id])

  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            String?
  errorDescription  String?
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
}

model Refund {
  id                String            @id @default(uuid())
  paymentId         String
  orderId           String
  razorpayRefundId  String?           @unique
  amount            Decimal           @db.Decimal(10, 2)
  reason            String
  status            String            @default("PENDING")
  initiatedByUserId String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creditNotes       AdminCreditNote[]

  @@index([orderId])
  @@index([paymentId])
  @@index([razorpayRefundId])
}

model Prescription {
  id                     String             @id @default(uuid())
  userId                 String
  fileUrl                String
  fileType               String
  originalName           String
  fileSize               Int
  status                 PrescriptionStatus @default(PENDING)
  rejectionReason        String?
  reviewedByPharmacistId String?
  reviewedAt             DateTime?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                   User               @relation("CustomerPrescriptions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?              @relation("PharmacistApprovals", fields: [reviewedByPharmacistId], references: [id])
  orders                 Order[]

  @@index([userId])
  @@index([status])
  @@index([reviewedByPharmacistId])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int      @default(5)
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
}

model LabTest {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  description     String
  category        String
  price           Decimal      @db.Decimal(10, 2)
  mrp             Decimal      @db.Decimal(10, 2)
  sampleType      String
  fastingRequired Boolean      @default(false)
  reportTimeHours Int          @default(24)
  testParameters  String[]     @default([])
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bookings        LabBooking[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
}

model LabBooking {
  id                   String           @id @default(uuid())
  bookingNumber        String           @unique
  userId               String
  labTestId            String
  patientName          String
  patientAge           Int
  patientGender        Gender
  sampleCollectionDate DateTime
  timeSlot             String
  addressId            String
  status               LabBookingStatus @default(SCHEDULED)
  reportUrl            String?
  paymentStatus        PaymentStatus    @default(PENDING)
  totalAmount          Decimal          @db.Decimal(10, 2)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  labTest              LabTest          @relation(fields: [labTestId], references: [id])
  address              Address          @relation(fields: [addressId], references: [id])

  @@index([userId])
  @@index([bookingNumber])
  @@index([status])
}

model Doctor {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  specialization     String
  qualification      String
  experienceYears    Int
  registrationNumber String
  consultationFee    Decimal       @db.Decimal(10, 2)
  avatar             String?
  bio                String
  languages          String[]      @default(["English", "Hindi"])
  isAvailable        Boolean       @default(true)
  rating             Decimal       @default(4.8) @db.Decimal(3, 1)
  reviewCount        Int           @default(120)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  appointments       Appointment[]

  @@index([slug])
  @@index([specialization])
  @@index([isAvailable])
}

model Appointment {
  id                String            @id @default(uuid())
  appointmentNumber String            @unique
  userId            String
  doctorId          String
  patientName       String
  patientAge        Int
  patientGender     Gender
  appointmentDate   DateTime
  timeSlot          String
  consultationType  String            @default("VIDEO")
  videoRoomUrl      String?
  status            AppointmentStatus @default(SCHEDULED)
  paymentStatus     PaymentStatus     @default(PENDING)
  fee               Decimal           @db.Decimal(10, 2)
  notes             String?
  prescriptionNotes String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor            Doctor            @relation(fields: [doctorId], references: [id])

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentNumber])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(ORDER)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model Banner {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  imageUrl   String
  targetUrl  String   @default("/products")
  buttonText String   @default("Shop Now")
  position   String   @default("HERO")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("GENERAL")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ============================================================================
// ADMIN-OWNED MODELS (PREFIXED admin_ IN DATABASE)
// ============================================================================

model AdminUser {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  roleId              String
  isActive            Boolean            @default(true)
  isTwoFactorEnabled  Boolean            @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  role                AdminRole          @relation(fields: [roleId], references: [id])
  sessions            AdminSession[]
  auditLogs           AdminAuditLog[]
  stockMovements      AdminStockMovement[]
  purchaseEntries     AdminPurchaseEntry[]
  assignedTickets     AdminSupportTicket[]
  importJobs          AdminImportJob[]
  issuedCreditNotes   AdminCreditNote[]

  @@index([email])
  @@index([roleId])
  @@index([isActive])
  @@map("admin_users")
}

model AdminRole {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique // SUPER_ADMIN, ADMIN, PHARMACIST, INVENTORY_MANAGER, SUPPORT, MARKETING
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  users       AdminUser[]
  permissions AdminRolePermission[]

  @@index([slug])
  @@map("admin_roles")
}

model AdminPermission {
  id          String               @id @default(uuid())
  module      String               // products, categories, orders, etc.
  action      String               // create, read, update, delete, export
  slug        String               @unique // module:action (e.g. products:create)
  description String?
  createdAt   DateTime             @default(now())

  rolePermissions AdminRolePermission[]

  @@unique([module, action])
  @@index([slug])
  @@map("admin_permissions")
}

model AdminRolePermission {
  id           String          @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime        @default(now())

  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id           String    @id @default(uuid())
  adminUserId  String
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          String    @id @default(uuid())
  adminUserId String?
  action      String    // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, EXPORT
  entity      String    // Product, Order, Category, InventoryBatch, User, Setting
  entityId    String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model AdminStockMovement {
  id              String                 @id @default(uuid())
  variantId       String
  batchId         String?
  type            AdminStockMovementType
  quantity        Int
  previousStock   Int
  newStock        Int
  referenceId     String?                // e.g. orderId or purchaseEntryId
  referenceType   String?                // ORDER, PURCHASE_ENTRY, MANUAL_ADJUSTMENT
  reason          String?
  createdByAdminId String?
  createdAt       DateTime               @default(now())

  variant         ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batch           InventoryBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy       AdminUser?             @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([batchId])
  @@index([type])
  @@index([createdAt])
  @@map("admin_stock_movements")
}

model AdminSupplier {
  id            String               @id @default(uuid())
  name          String               @unique
  code          String               @unique
  contactPerson String?
  email         String?
  phone         String
  address       String?
  gstin         String?
  drugLicenceNo String?
  creditDays    Int                  @default(30)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  purchases     AdminPurchaseEntry[]

  @@index([code])
  @@index([isActive])
  @@map("admin_suppliers")
}

model AdminPurchaseEntry {
  id               String              @id @default(uuid())
  invoiceNumber    String              @unique
  supplierId       String
  invoiceDate      DateTime
  receivedDate     DateTime            @default(now())
  subtotal         Decimal             @db.Decimal(10, 2)
  taxAmount        Decimal             @db.Decimal(10, 2)
  totalAmount      Decimal             @db.Decimal(10, 2)
  status           AdminPurchaseStatus @default(DRAFT)
  notes            String?
  createdByAdminId String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  supplier         AdminSupplier       @relation(fields: [supplierId], references: [id])
  createdBy        AdminUser           @relation(fields: [createdByAdminId], references: [id])
  items            AdminPurchaseItem[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([status])
  @@map("admin_purchase_entries")
}

model AdminPurchaseItem {
  id              String             @id @default(uuid())
  purchaseEntryId String
  variantId       String
  batchNumber     String
  mfgDate         DateTime
  expiryDate      DateTime
  quantity        Int
  freeQuantity    Int                @default(0)
  purchaseRate    Decimal            @db.Decimal(10, 2)
  mrp             Decimal            @db.Decimal(10, 2)
  gstRate         Decimal            @db.Decimal(5, 2)
  taxAmount       Decimal            @db.Decimal(10, 2)
  totalAmount     Decimal            @db.Decimal(10, 2)
  createdAt       DateTime           @default(now())

  purchaseEntry   AdminPurchaseEntry @relation(fields: [purchaseEntryId], references: [id], onDelete: Cascade)
  variant         ProductVariant     @relation(fields: [variantId], references: [id])

  @@index([purchaseEntryId])
  @@index([variantId])
  @@map("admin_purchase_items")
}

model AdminSupportTicket {
  id               String               @id @default(uuid())
  ticketNumber     String               @unique // e.g. TKT-2026-1042
  customerId       String
  subject          String
  priority         AdminTicketPriority  @default(MEDIUM)
  status           AdminTicketStatus    @default(OPEN)
  assignedToAdminId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  customer         User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo       AdminUser?           @relation(fields: [assignedToAdminId], references: [id], onDelete: SetNull)
  messages         AdminTicketMessage[]

  @@index([ticketNumber])
  @@index([customerId])
  @@index([status])
  @@index([assignedToAdminId])
  @@map("admin_support_tickets")
}

model AdminTicketMessage {
  id             String             @id @default(uuid())
  ticketId       String
  senderType     AdminSenderType    @default(ADMIN)
  senderId       String             // ID of AdminUser or User
  message        String
  attachments    String[]           @default([])
  isInternalNote Boolean            @default(false)
  createdAt      DateTime           @default(now())

  ticket         AdminSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("admin_ticket_messages")
}

model AdminEmailTemplate {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // ORDER_CONFIRMED, PRESCRIPTION_APPROVED, etc.
  subject     String
  htmlContent String
  textContent String?
  variables   Json     // Array of variable placeholder strings e.g. ["orderNumber", "customerName"]
  category    String   @default("GENERAL") // ORDER, PRESCRIPTION, AUTH, PROMO, SYSTEM
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@map("admin_email_templates")
}

model AdminNotificationLog {
  id           String                   @id @default(uuid())
  channel      AdminNotificationChannel
  recipient    String                   // email address, phone number, redis channel, url
  eventType    String                   // order.created, prescription.approved, etc.
  payload      Json
  status       AdminNotificationStatus  @default(SUCCESS)
  errorMessage String?
  retryCount   Int                      @default(0)
  lastRetryAt  DateTime?
  createdAt    DateTime                 @default(now())

  @@index([channel])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@map("admin_notification_logs")
}

model AdminWebhookEvent {
  id              String             @id @default(uuid())
  source          AdminWebhookSource
  eventType       String             // payment.captured, refund.processed, etc.
  eventId         String?            // external event id
  payload         Json
  status          AdminWebhookStatus @default(RECEIVED)
  processingError String?
  attempts        Int                @default(1)
  createdAt       DateTime           @default(now())
  processedAt     DateTime?

  @@index([source])
  @@index([status])
  @@index([eventId])
  @@map("admin_webhook_events")
}

model AdminImportJob {
  id               String            @id @default(uuid())
  type             AdminImportType
  fileName         String
  totalRows        Int               @default(0)
  processedRows    Int               @default(0)
  successfulRows   Int               @default(0)
  failedRows       Int               @default(0)
  errorReport      Json?             // Array of row errors: [{row: 2, error: "Invalid price"}]
  status           AdminImportStatus @default(PENDING)
  createdByAdminId String
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  createdBy        AdminUser         @relation(fields: [createdByAdminId], references: [id])

  @@index([type])
  @@index([status])
  @@index([createdByAdminId])
  @@map("admin_import_jobs")
}

model AdminCreditNote {
  id               String                @id @default(uuid())
  creditNoteNumber String                @unique // CN-2026-0042
  orderId          String
  refundId         String?
  customerId       String
  amount           Decimal               @db.Decimal(10, 2)
  gstAmount        Decimal               @default(0) @db.Decimal(10, 2)
  reason           String
  status           AdminCreditNoteStatus @default(ISSUED)
  pdfUrl           String?
  createdByAdminId String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  order            Order                 @relation(fields: [orderId], references: [id])
  refund           Refund?               @relation(fields: [refundId], references: [id], onDelete: SetNull)
  createdBy        AdminUser             @relation(fields: [createdByAdminId], references: [id])

  @@index([creditNoteNumber])
  @@index([orderId])
  @@index([status])
  @@map("admin_credit_notes")
}
